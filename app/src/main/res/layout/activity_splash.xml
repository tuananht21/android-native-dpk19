<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D01012">

    <!-- Bố cục tối giản căn giữa màn hình -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Logo ứng dụng (Hiển thị trực tiếp) -->
        <ImageView
            android:id="@+id/imgLogoSplash"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:contentDescription="Logo LEGO Store"
            android:src="@drawable/lego" />

        <!-- Tên ứng dụng gọn gàng -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-black"
            android:text="LEGO STORE"
            android:textColor="#FFCF00"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Vòng xoay Loading -->
        <ProgressBar
            android:id="@+id/progressBarSplash"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="32dp"
            android:indeterminateTint="#FFCF00" />

    </LinearLayout>

</RelativeLayout>