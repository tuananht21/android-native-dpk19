<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <!-- Tiêu đề Đăng ký -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.05"
        android:text="ĐĂNG KÝ TÀI KHOẢN"
        android:textColor="#D01012"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Tạo tài khoản để trải nghiệm mua sắm LEGO"
        android:textColor="#666666"
        android:textSize="13sp" />

    <!-- Ô nhập Họ và tên -->
    <EditText
        android:id="@+id/edtHoTenDK"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="28dp"
        android:background="@android:drawable/editbox_background"
        android:drawableStart="@drawable/ic_person_avatar"
        android:drawableTint="#888888"
        android:drawablePadding="12dp"
        android:hint="Họ và tên"
        android:inputType="textPersonName"
        android:paddingHorizontal="12dp"
        android:textSize="14sp" />

    <!-- Ô nhập Email -->
    <EditText
        android:id="@+id/edtEmailDK"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@android:drawable/editbox_background"
        android:drawableStart="@drawable/ic_search"
        android:drawableTint="#888888"
        android:drawablePadding="12dp"
        android:hint="Email"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="12dp"
        android:textSize="14sp" />

    <!-- Ô nhập Số điện thoại -->
    <EditText
        android:id="@+id/edtSdtDK"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@android:drawable/editbox_background"
        android:drawableStart="@drawable/ic_phone"
        android:drawableTint="#888888"
        android:drawablePadding="12dp"
        android:hint="Số điện thoại"
        android:inputType="phone"
        android:paddingHorizontal="12dp"
        android:textSize="14sp" />

    <!-- Ô nhập Mật khẩu -->
    <EditText
        android:id="@+id/edtMatKhauDK"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@android:drawable/editbox_background"
        android:drawableStart="@drawable/ic_logout"
        android:drawableTint="#888888"
        android:drawablePadding="12dp"
        android:hint="Mật khẩu"
        android:inputType="textPassword"
        android:paddingHorizontal="12dp"
        android:textSize="14sp" />

    <!-- Nút Đăng ký -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnDangKy"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:background="#D01012"
        android:text="Đăng ký"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Link chuyển về Đăng nhập -->
    <TextView
        android:id="@+id/tvQuayLaiDangNhap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:padding="8dp"
        android:text="Đã có tài khoản? Đăng nhập ngay"
        android:textColor="#D01012"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>