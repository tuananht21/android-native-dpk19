<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Dòng 1: Mã đơn hàng & Nút Hủy -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvMaDonHang"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mã đơn hàng: #1"
            android:textColor="#222222"
            android:textSize="15sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnHuyDonHang"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="#D01012"
            android:paddingHorizontal="12dp"
            android:text="Hủy đơn"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Dòng 2: Trạng thái đơn -->
    <TextView
        android:id="@+id/tvTrangThaiDonHang"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Trạng thái: Chờ xác nhận"
        android:textColor="#E65100"
        android:textSize="13sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="10dp"
        android:background="#F0F0F0" />

    <!-- Dòng 3: Tổng tiền -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tổng thanh toán:"
            android:textColor="#666666"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvTongTienDonHang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4.500.000 đ"
            android:textColor="#D01012"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="12dp"
        android:background="#F8F9FA" />

</LinearLayout>