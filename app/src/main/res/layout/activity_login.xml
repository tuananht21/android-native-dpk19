<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <!-- Tiêu đề Đăng nhập -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.05"
        android:text="ĐĂNG NHẬP"
        android:textColor="#D01012"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Chào mừng bạn quay trở lại LEGO Store"
        android:textColor="#666666"
        android:textSize="13sp" />

    <!-- Ô nhập Email -->
    <EditText
        android:id="@+id/edtEmailLogin"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="32dp"
        android:background="@android:drawable/editbox_background"
        android:drawableStart="@drawable/ic_search"
        android:drawableTint="#888888"
        android:drawablePadding="12dp"
        android:hint="Email tài khoản"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="12dp"
        android:textSize="14sp" />

    <!-- Ô nhập Mật khẩu -->
    <EditText
        android:id="@+id/edtMatKhauLogin"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@android:drawable/editbox_background"
        android:drawableStart="@drawable/ic_logout"
        android:drawableTint="#888888"
        android:drawablePadding="12dp"
        android:hint="Mật khẩu"
        android:inputType="textPassword"
        android:paddingHorizontal="12dp"
        android:textSize="14sp" />

    <!-- Nút Đăng nhập mới phẳng, vuông vức nhẹ -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnDangNhap"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:background="#D01012"
        android:text="Đăng nhập"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Chuyển sang trang Đăng ký -->
    <TextView
        android:id="@+id/tvChuyenSangDangKy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:padding="8dp"
        android:text="Chưa có tài khoản? Đăng ký ngay"
        android:textColor="#D01012"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>