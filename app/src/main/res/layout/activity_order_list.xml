<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- 1. Toolbar phẳng có nút Quay lại -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#D01012"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnOrderQuayLai"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="2dp"
            android:rotation="180"
            android:src="@drawable/ic_logout"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="LỊCH SỬ ĐƠN HÀNG"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. Khối hiển thị Danh sách hoặc Trạng thái trống -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Danh sách đơn hàng -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvDonHang"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp" />

        <!-- Giao diện hiển thị khi người dùng chưa có đơn hàng -->
        <LinearLayout
            android:id="@+id/layoutLichSuTrong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:alpha="0.3"
                android:src="@drawable/ic_shopping_cart"
                app:tint="#666666" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Bạn chưa có đơn hàng nào"
                android:textColor="#666666"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Các đơn hàng đã mua sẽ xuất hiện tại đây"
                android:textColor="#888888"
                android:textSize="13sp" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>